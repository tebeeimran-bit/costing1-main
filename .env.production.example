APP_NAME="Costing System"
APP_ENV=production
APP_MODE=production
APP_KEY=
APP_DEBUG=false
# Ganti dengan IP statis atau hostname internal server.
# Gunakan http://IP-SERVER selama HTTPS internal belum disiapkan.
APP_URL=http://192.168.144.130

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=costing_production
DB_USERNAME=costing_app
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Identitas instalasi agar cache tidak bertabrakan dengan aplikasi lain.
CACHE_PREFIX=costing-production-cache

MAIL_MAILER=log
MAIL_FROM_ADDRESS="costing@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Hanya dipakai satu kali saat instalasi awal, lalu hapus nilainya dari .env.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
