APP_NAME="Costing System Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=costing_staging
DB_USERNAME=
DB_PASSWORD=
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
BACKUP_TIMEOUT_SECONDS=600
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
SLOW_REQUEST_MS=750
SYSTEM_EVENT_RETENTION_DAYS=30
